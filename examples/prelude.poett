-- Simple Poett prelude

ind empty : U₀

ind unit : U₀
| tt : unit

ind top : Prop
| I : top

ind bot : Prop

def not (A : Prop) : Prop
    := A → bot

ind sum (A : U₀) (B : U₀) : U₀
| inl : A → sum A B
| inr : B → sum A B

ind sig (A : U₀) (B : A → U₀) : U₀
| pr : Π(a : A) B a → sig A B

def prod (A : U₀) (B : U₀) : U₀ := sig A (λ (_ : A), B)

ind ex (A : Prop) (B : A → Prop) : Prop
| prEx : Π(a : A) B a → ex A B

ind eq (A : U₀) (x : A) : A → Prop
| refl : eq A x x

ind bool : U₀
| false : bool
| true : bool

def neq (A : U₀) (x : A) (y : A) : Prop
    := not (eq A x y)

def true-ne-false-fam : bool → Prop
    := elim U₀ bool (λ (_ : bool), Prop) bot top

proof true-ne-false : neq bool true false
      := elim Prop eq bool true (λ (b : bool) (_ : eq bool true b), true-ne-false-fam b) I false
