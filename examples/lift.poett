#import prelude

ind lift (P : Prop) : U₀
| up : P → lift P

def down (P : Prop) : lift P → P
    := elim Prop lift P (λ (_ : lift P), P) (λ (H : P), H)

ind prop-box (A : U₀) : Prop
| box : A → prop-box A

#fail def unbox (A : U₀) : prop-box A → A
          := elim U₀ prop-box A (λ (_ : prop-box A), A) (λ (x : A), x)

def prop-eq (P : Prop) (H₁ : P) (H₂ : P) : Prop
    := eq (lift P) (up P H₁) (up P H₂)

def prop-refl (P : Prop) (H : P) : prop-eq P H H
    := refl (lift P) (up P H)

axiom propext (P : Prop) (H₁ : P) (H₂ : P) : prop-eq P H₁ H₂

def prop-eq-elim (P : Prop) (H₁ : P) (T : Π(H₂ : P) prop-eq P H₁ H₂ → U₀)
                 (T₁ : T H₁ (prop-refl P H₁)) (H₂ : P) : Π (r : prop-eq P H₁ H₂) T H₂ r
     := elim U₀ eq (lift P) (up P H₁)
          (elim U₁ lift P
             (λ (H₂ : lift P), eq (lift P) (up P H₁) H₂ → U₀)
             (λ (H₂ : P), T H₂)
          ) T₁ (up P H₂)
