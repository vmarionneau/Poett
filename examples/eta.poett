#import nat

def eta-pi : Π(A : U₀)
               Π(B : A → U₀)
               Π(f : Π(x : A) B x)
                   eq (Π(x : A) B x) f (λ (x : A), f x)
            := λ (A : U₀),
               λ (B : A → U₀),
               λ (f : Π(x : A) B x),
                 refl (Π(x : A) B x) f

def eta-unit : Π(x : unit) eq unit x tt
    := λ (x : unit), refl unit tt

#fail def eta-nat : Π(x : nat) eq nat x zero
          := λ (x : nat), refl nat zero

def unit-sq : U₀ := sig unit (λ (_ : unit), unit)

def eta-sig-unit (x : unit-sq): eq unit-sq x (pr unit (λ (_ : unit), unit) tt tt)
    := refl unit-sq x

def unit-bool : U₀ := sig unit (λ (_ : unit), bool)

#fail def eta-unit-bool (x : unit-bool) : eq unit-bool x (pr unit (λ (_ : unit), bool) tt true)
          := refl unit-bool (pr unit (λ (_ : unit), bool) tt true)

def eta-pi-unit (A : U₀) (f : A → unit) (g : A → unit) : eq (A → unit) f g
    := refl (A → unit) (λ (_ : A), tt)

#check eta-pi
#check eta-unit
#check eta-sig-unit
#check eta-pi-unit
