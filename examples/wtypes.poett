#import inductives

ind W (A : U₀) (B : A → U₀) : U₀
| sup : Π(a : A) Π (f : B a → W A B) W A B

-- Extensional equality on W-types
def W-eq (A : U₀) (B : A → U₀) : W A B → W A B → Prop
    := elim U₀ W A B (λ (_ : W A B), W A B → Prop)
          (λ (a : A) (f : B a → W A B) (ih : B a → W A B → Prop),
            elim U₀ W A B (λ (_ : W A B), Prop)
              (λ (a₀ : A) (g : B a₀ → W A B) (_ : B a₀ → Prop),
                ex (eq A a a₀) (λ (p : eq A a a₀), Π(b : B a) ih b (g (elim U₀ eq A a (λ (a₁ : A) (_ : eq A a a₁), B a₁) b a₀ p)))
              )
          )

def W-eq-refl (A : U₀) (B : A → U₀) : Π(w : W A B) W-eq A B w w
    := elim Prop W A B (λ (w : W A B), W-eq A B w w)
        (λ (a : A) (f : B a → W A B) (ih : Π(b : B a) W-eq A B (f b) (f b)),
           prEx (eq A a a)
              (λ (p : eq A a a), Π(b : B a) W-eq A B (f b) (f (elim U₀ eq A a (λ (a₀ : A) (_ : eq A a a₀), B a₀) b a p)))
              (refl A a) ih
        )

def wlistCs (A : U₀) : U₀ := sum unit A

def wlistAr (A : U₀) : wlistCs A → U₀
    := elim U₁ sum unit A (λ (_ : sum unit A), U₀) (λ (_ : unit), empty) (λ (_ : A), unit)

def wlist (A : U₀) : U₀ := W (wlistCs A) (wlistAr A)

def wnil (A : U₀) : wlist A
    := sup (wlistCs A) (wlistAr A) (inl unit A tt) (elim U₀ empty (λ (_ : empty), wlist A))

def wcons (A : U₀) (h : A) (t : wlist A) : wlist A
    := sup (wlistCs A) (wlistAr A) (inr unit A h) (λ (_ : unit), t)

def listToWlist (A : U₀) : list A → wlist A
    := elim U₀ list A (λ (_ : list A), wlist A) (wnil A) (λ (h : A) (_ : list A) (t : wlist A), wcons A h t)

def wlistToList (A : U₀) : wlist A → list A
    :=  elim U₀ W (wlistCs A) (wlistAr A)
            (λ (_ : W (wlistCs A) (wlistAr A)), list A)
            (elim U₀ sum unit A
                  (λ (x : sum unit A), (wlistAr A x → wlist A) → (wlistAr A x → list A) → list A)
                  (λ (_ : unit) (_ : empty → wlist A) (_ : empty → list A), nil A)
                  (λ (h : A) (_ : unit → wlist A) (t : unit → list A), cons A h (t tt))
             )

def foo₀ : list unit
    := nil unit
-- cons unit tt (cons unit tt (nil unit))

def bar₀ : wlist unit
    := listToWlist unit foo₀

def oof : list unit
    := wlistToList unit bar₀

#check (refl (list unit) foo₀ : eq (list unit) foo₀ oof)

#nf foo₀
#nbe foo₀
#nf bar₀
#nbe bar₀
#nf oof
#nbe oof

def wnat-fam := elim U₁ bool (λ (_ : bool), U₀) empty unit

def wnat : U₀ := W bool wnat-fam

def wzero : wnat := sup bool wnat-fam false (elim U₀ empty (λ (_ : empty), wnat))

def wsucc (n : wnat) : wnat := sup bool wnat-fam true (λ (_ : unit), n)
