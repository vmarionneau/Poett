-- Facts about equality

#import prelude

def sym (A : U₀) (x : A) : Π (y : A) eq A x y → eq A y x
    := elim Prop eq A x (λ (y : A) (_ : eq A x y), eq A y x) (refl A x)

def trans (A : U₀) (x : A) (y : A) (z : A) : eq A x y → eq A y z → eq A x z
    := elim Prop eq A x (λ (y₀ : A) (_ : eq A x y₀), eq A y₀ z → eq A x z)
            (λ (p : eq A x z), p) y

def ap (A : U₀) (B : U₀) (f : A → B) (x : A) : Π (y : A) eq A x y → eq B (f x) (f y)
    := elim Prop eq A x (λ (y : A) (_ : eq A x y), eq B (f x) (f y))
            (refl B (f x))
              
-- Leibniz equality
def lbz (A : U₀) (x : A) (y : A) : Prop
    := Π (P : A → Prop) P x → P y

def lbz-refl (A : U₀) (x : A) : lbz A x x
    := λ (P : A → Prop) (H : P x), H

def lbz-eq (A : U₀) (x : A) (y : A) : lbz A x y → eq A x y
    := λ (p : lbz A x y), p (λ (z : A), eq A x z) (refl A x)

def eq-lbz (A : U₀) (x : A) (y : A) : eq A x y → lbz A x y
    := λ (p : eq A x y), elim Prop eq A x (λ (z : A) (_ : eq A x z), lbz A x z) (lbz-refl A x) y p
